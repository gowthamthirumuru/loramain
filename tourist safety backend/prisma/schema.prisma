generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  salt          String?
  name          String
  role          String    @default("operator")
  status        String    @default("active")
  phone         String?
  avatar        String?
  lastLogin     DateTime?
  loginAttempts Int       @default(0)
  lockUntil     DateTime?
  preferences   Json?
  refreshToken  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  actionLogs    ActionLog[]

  @@index([email])
  @@index([role])
}

model Tourist {
  id                     String        @id @default(uuid())
  name                   String
  email                  String?
  phone                  String
  emergency_contact      String
  emergency_contact_name String?
  device_id              String        @unique
  nationality            String?
  group_size             Int           @default(1)
  trip_start             DateTime      @default(now())
  trip_end               DateTime?
  status                 String        @default("registered")
  last_location          Json?
  last_seen              DateTime      @default(now())
  isDeleted              Boolean       @default(false)
  deletedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  
  locationLogs           LocationLog[]
  sOSAlerts              SOSAlert[]

  @@index([device_id])
  @@index([status])
  @@index([phone])
}

model LocationLog {
  id         String   @id @default(uuid())
  device_id  String
  tourist    Tourist? @relation(fields: [tourist_id], references: [id])
  tourist_id String?
  x          Float
  y          Float
  lat        Float?
  lng        Float?
  rssi       Float?
  is_sos     Boolean  @default(false)
  timestamp  DateTime @default(now())

  @@index([tourist_id, timestamp])
  @@index([device_id, timestamp])
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("safe")
  boundary    Json
  center      Json
  color       String   @default("#3388ff")
  alerts      Json?
  maxCapacity Int?
  currentCount Int     @default(0)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SOSAlert {
  id           String    @id @default(uuid())
  tourist      Tourist   @relation(fields: [tourist_id], references: [id])
  tourist_id   String
  device_id    String
  location     Json
  status       String    @default("active")
  resolved_at  DateTime?
  resolved_by  String?
  notes        String?
  created_at   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([tourist_id])
}

model ResponseTeam {
  id                String   @id @default(uuid())
  name              String
  type              String
  status            String   @default("available")
  location          String   @default("Base Station")
  coordinates       Json?
  members           Int      @default(4)
  eta               String?
  currentAssignment String?
  contact           Json?
  leader            Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
}

model Anchor {
  id              String   @id @default(uuid())
  anchor_id       String   @unique
  name            String
  local_position  Json     // { x: Float, y: Float }
  gps_position    Json?    // { lat: Float, lng: Float }
  is_master       Boolean  @default(false)
  status          String   @default("offline")
  last_heartbeat  DateTime?
  hardware        Json?
  stats           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([anchor_id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  severity  String
  userId    String?
  createdAt DateTime @default(now())
}

model Conversation {
  id              Int       @id @default(autoincrement())
  participantName String
  participantId   String?
  type            String
  status          String    @default("active")
  priority        String    @default("medium")
  unreadCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  sender         String
  content        String
  isOwnMessage   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  read           Boolean      @default(false)
}

model ActionLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([action])
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique // e.g., 'gps_reference'
  value     Json     // e.g., { lat: 11.0, lng: 76.0 }
  updatedAt DateTime @updatedAt
}
