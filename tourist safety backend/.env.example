# =====================================================
# Tourist Safety Backend - Environment Configuration
# =====================================================
# Copy this file to .env and update values as needed

# MongoDB Configuration
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/tourist_safety
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tourist_safety

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# API Keys
# Gateway API key for LoRa gateway authentication
GATEWAY_API_KEY=your-super-secret-gateway-key

# JWT Configuration (for future auth)
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
