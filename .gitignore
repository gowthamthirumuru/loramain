# --- Python ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/

# --- Node.js ---
node_modules/
package-lock.json

# --- Build Outputs ---
dist/
build/
.vite/

# --- OS Files ---
Thumbs.db
Desktop.ini
.DS_Store

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Secrets (never commit!) ---
.env
.env.local
.env.*.local

# --- Coverage ---
coverage/
.nyc_output/
htmlcov/

# --- Temp Files ---
tmp/
temp/
*.tmp
